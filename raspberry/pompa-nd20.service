[Unit]
Description=Odczyt miernika Lumel ND20 (RS-485, port 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pompa
ExecStart=/usr/bin/node /home/pi/pompa/nd20.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
